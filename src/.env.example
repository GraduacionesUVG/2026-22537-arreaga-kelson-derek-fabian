ENVIRONMENT=DEVELOPMENT
# /docs, /redoc y /openapi.json. Sin definir: activos fuera de PRODUCTION y apagados en PRODUCTION.
# API_DOCS_ENABLED=true
PROJECT_NAME=GP-Agent-Backend
JWT_SECRET_KEY=change-me
# Clave para cifrar el número de WhatsApp de los estudiantes en Mongo (texto largo
# y aleatorio, ver src/core/pii.py). Obligatoria en PRODUCTION. NO cambiarla ni
# perderla: los números guardados quedarían ilegibles.
USER_DATA_SECRET=

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=gp_agent_db

# Autenticacion - WhatsApp (OTP por correo), Administracion (correo+password) y KDS (usuario+PIN)
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
OTP_CODE_EXPIRE_MINUTES=10
MAX_VERIFICATION_REQUESTS=3
VERIFICATION_REQUEST_WINDOW_HOURS=24
MAX_OTP_ATTEMPTS=5
INACTIVE_USER_TTL_DAYS=180
BACKEND_BASE_URL=http://localhost:8000

# Pagina de login/registro (frontend) que el bot le manda al estudiante
# cuando su numero no esta registrado o le falta verificar el correo.
PROD_LOGIN_URL=https://qorder.lat/login

# Header X-Internal-Api-Key compartido con el servicio agent/ (mismo valor en agent/.env).
# OBLIGATORIO: lo exigen todas las rutas que usa el agente (menus, restaurantes, pedidos,
# /auth/whatsapp/check, /api/users/*). Vacio = esas rutas responden 503.
INTERNAL_API_KEY=

# Envio de correo (OTP de verificacion) via la API HTTP de Resend (no SMTP:
# los planes free de Render bloquean los puertos SMTP 25/465/587 desde
# sept-2025, la API HTTP usa HTTPS normal y no tiene ese problema). Si
# RESEND_API_KEY se deja vacio, se imprime el correo en consola (modo
# desarrollo, ver src/integrations/email_client.py).
#   RESEND_API_KEY=<API key de Resend, empieza con re_>
#   EMAIL_FROM_ADDRESS=otp@<dominio verificado en Resend>
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@gp-agent.local

# Orquestador LLM (agent/) - ver agent/orchestator.py y agent/transcription.py
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1

# WhatsApp (Meta Cloud API) - Modulo B
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Message Templates (botones con URL).
# Con false, todos los avisos salen como texto con el link pegado.
WHATSAPP_TEMPLATES_ENABLED=false
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_PAYMENT=link_de_pago
WHATSAPP_TEMPLATE_DELIVERED=pedido_entregado
# Parte fija de la URL del botón dinámico de pago (antes de {{1}}) y página
# estática de calificación. Pendientes: las páginas todavía no existen.
PAYMENT_URL_BASE=
RATING_URL=

# Pasarela de pagos Tilopay (links de pago). Cada restaurante tiene SU PROPIA
# cuenta: las credenciales se cargan desde el panel de administracion
# (PUT /api/admin/restaurant/payment-gateway), no aqui.
# BACKEND_BASE_URL debe ser la URL publica del API: Tilopay la usa para el
# webhook y el retorno del cliente.
#
# Clave para cifrar en Mongo las credenciales de cada restaurante (texto largo
# y aleatorio). Obligatoria en PRODUCTION. Si se cambia, cada restaurante debe
# volver a cargar sus credenciales.
PAYMENT_CREDENTIALS_SECRET=
# Opcional: secreto para firmar la URL del webhook (vacio = JWT_SECRET_KEY)
TILOPAY_WEBHOOK_SECRET=
# Pagos simulados (POST /webhooks/bac-payment) para restaurantes sin cuenta de
# Tilopay. Sin definir = permitidos fuera de PRODUCTION, prohibidos en PRODUCTION.
# SIMULATED_PAYMENTS_ENABLED=false

# Microsoft Entra ID (SSO) - Modulo A
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# Sin Kafka, el API manda los WhatsApp al estudiante en segundo plano (fallback en proceso).
NOTIFY_INLINE_WITHOUT_KAFKA=true

# --- Módulo de administración ---
ADMIN_FRONTEND_URL=http://localhost:5173
# Frontends autorizados a llamar al API desde el navegador (CORS), separados por coma, sin "/" final.
# En producción: las URLs de los sitios de Render (kds, admin, ops y register).
# Vacío en DEVELOPMENT = se permiten localhost:5173-5176.
CORS_ORIGINS=
PASSWORD_RESET_EXPIRE_MINUTES=60

# --- Ventana de pago de un pedido aceptado (minutos) ---
PAYMENT_LINK_ASAP_MINUTES=10
PAYMENT_LINK_MIN_MINUTES=5
PAYMENT_LINK_MAX_MINUTES=15
PAYMENT_EXPIRY_CHECK_SECONDS=30
# No se aceptan pedidos en los últimos N minutos antes del cierre del restaurante.
LAST_ORDER_MINUTES_BEFORE_CLOSE=30
# Monto mínimo por pedido en quetzales (solo productos, sin tarifa de servicio). 0 = sin mínimo.
MIN_ORDER_AMOUNT=25
