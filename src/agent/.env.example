# Backend de QOrder (GP-Agent-Backend) al que las tools le hacen requests --
BACKEND_API_URL=http://localhost:8000
# Mismo valor que INTERNAL_API_KEY del backend. OBLIGATORIO: todas las rutas que
# usa el agente lo exigen; sin él el backend responde 503 y el bot no funciona.
INTERNAL_API_KEY=

# OpenAI (Function Calling del orquestador)
OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-4o-mini
# Whisper (notas de voz de WhatsApp, ver transcription.py)
TRANSCRIPTION_MODEL=whisper-1
# Vacío = Whisper detecta el idioma solo (el spanglish funciona con ambos).
TRANSCRIPTION_LANGUAGE=es

# WhatsApp Cloud API (Meta for Developers)
# VERIFY_TOKEN: cualquier string que tú definas, se pone igual en la config
# del webhook en Meta (paso de verificación, GET /).
VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración > Básica). Con él se verifica que cada
# mensaje que llega al webhook venga de Meta (firma X-Hub-Signature-256). OBLIGATORIO
# en producción: sin él, cualquiera puede mandar mensajes haciéndose pasar por un estudiante.
WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN: token de acceso de la app de Meta (permite descargar audios
# y enviar mensajes -- Send Message API).
WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: id del número de WhatsApp de la app (Meta for
# Developers -> tu app -> WhatsApp -> API Setup), necesario para responder.
WHATSAPP_PHONE_NUMBER_ID=

# Control de costo de mensajes de WhatsApp (se cobra por cada mensaje enviado)
# Máximo de mensajes de WhatsApp por respuesta del agente (1 = todo en un solo mensaje).
MAX_MESSAGES_PER_REPLY=1
# Máximo de mensajes salientes por número al día (0 = sin límite). Al llegar se
# manda un único aviso y el bot deja de contestar hasta el día siguiente.
MAX_DAILY_MESSAGES_PER_USER=30
# Largo máximo (caracteres) de una respuesta: la gente no lee mensajes largos.
# Si el agente se pasa, se le pide reescribirla más corta antes de enviarla (0 = sin revisión).
MAX_REPLY_CHARS=500

# Memoria entre sesiones (ver memory.py, colección user_memory en Mongo)
# Horas sin mensajes para dar la sesión por terminada: se resume (preferencias +
# resumen) y la siguiente conversación empieza de cero, pero con ese contexto.
SESSION_IDLE_HOURS=3

# Logs: por default no se imprime el texto de los mensajes ni el número completo
# (los logs de Render los ve cualquiera con acceso). true solo en local para depurar.
LOG_MESSAGE_CONTENT=false

# Guardrails (ver guardrails.py): defensa contra prompt injection y verificación
# de la respuesta contra lo que devolvieron las tools.
# Largo máximo (caracteres) del mensaje del estudiante; lo que pase se recorta.
MAX_INPUT_CHARS=1000
# Veces que se le pide al modelo corregir una respuesta que no pasó la verificación
# antes de mandar el mensaje seguro (0 = no reintenta).
MAX_GUARDRAIL_RETRIES=1
# Hosts extra permitidos en links de las respuestas (aparte de PROD_LOGIN_URL y
# BACKEND_API_URL), separados por coma.
ALLOWED_REPLY_URLS=

# Message Templates (botón de URL en vez del link pegado).
# Con false, el link de registro sale como texto.
WHATSAPP_TEMPLATES_ENABLED=false
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_REGISTER=registro_usuario
